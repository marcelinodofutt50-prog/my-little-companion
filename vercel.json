{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "ignoreCommand": "exit 1",
  "regions": ["gru1"],
  "crons": [
    {
      "path": "/api/public/hooks/daily-maintenance",
      "schedule": "0 6 * * *"
    }
  ],


  "github": {
    "enabled": true,
    "autoJobCancelation": true,
    "silent": false
  },
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
