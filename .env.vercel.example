# Variáveis que precisam ser cadastradas na Vercel
# (Project Settings → Environment Variables → Production + Preview)
#
# Copie os valores do backend do Lovable Cloud. Sem elas o app sobe,
# mas checkout / webhooks / painel admin falham.

# --- Cliente (expostas no bundle, precisam do prefixo VITE_) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Servidor (NUNCA com prefixo VITE_) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Painéis Yaarsa
YAARSA_BASE_URL=
YAARSA_ADMIN_KEY=
YAARSA_V46_BASE_URL=
YAARSA_V46_ADMIN_KEY=

# Criptografia / integrações internas
LICENSE_ENC_KEY=
APK_WORKER_HMAC_SECRET=
CRON_TRIGGER_TOKEN=
